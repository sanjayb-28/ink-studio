{
  "name": "@sanjayb-28/ink-runtime",
  "version": "1.0.2",
  "type": "module",
  "description": "Canvas ink painting, image reveal and interaction primitives.",
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js"
    },
    "./threads": {
      "types": "./dist/threads/renderer.d.ts",
      "import": "./dist/threads.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "lucide": "^1.69.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjayb-28/ink-studio.git",
    "directory": "packages/runtime"
  }
}
