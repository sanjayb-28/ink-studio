{
  "name": "ink-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first tool for image treatments and expressive ink animation.",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "apps/studio",
    "packages/runtime"
  ],
  "scripts": {
    "dev": "vite --config apps/studio/vite.config.ts --host 127.0.0.1 --port 4319 --strictPort",
    "check": "tsc --noEmit",
    "build:runtime": "npm run build --workspace @sanjayb-28/ink-runtime",
    "build:studio": "vite build --config apps/studio/vite.config.ts",
    "build": "npm run check && npm run build:runtime && npm run build:studio",
    "preview": "vite preview --config apps/studio/vite.config.ts --host 127.0.0.1 --port 4320 --strictPort",
    "test": "node scripts/test-runtime.mjs && node tests/architecture.mjs && node tests/dev/image-api.mjs",
    "test:compiler": ".venv/bin/python -m unittest discover -s tests/compiler -p 'test_*.py'",
    "compiler:setup": "node scripts/setup-compiler.mjs",
    "image": "node scripts/image.mjs",
    "samples:build": "node scripts/build-samples.mjs",
    "materials:build": ".venv/bin/python scripts/prepare-materials.py",
    "pack:runtime": "npm run build:runtime && node scripts/pack-runtime.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.2.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjayb-28/ink-studio.git"
  }
}
