{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@sanjayb-28/ink-runtime": ["./packages/runtime/src/index.ts"],
      "@sanjayb-28/ink-runtime/materials": ["./packages/runtime/src/materials.ts"]
    }
  },
  "include": ["apps/studio/src", "packages/runtime/src"]
}
